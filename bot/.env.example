# =====================================================
#  Faisal Discord Suite — Bot Environment
#  انسخ هذا الملف إلى bot/.env واملأ القيم
# =====================================================

# توكن البوت من Discord Developer Portal
# https://discord.com/developers/applications -> اختر تطبيقك -> Bot -> Reset Token
DISCORD_TOKEN=

# Application (Client) ID من نفس الصفحة -> General Information
DISCORD_APP_ID=

# Guild ID للتسجيل السريع للأوامر (يمكن تركه فاضي للتسجيل عالمي)
# للحصول عليه: فعّل Developer Mode في ديسكورد، انقر يمين على السيرفر -> Copy ID
DEFAULT_GUILD_ID=

# مالك البوت (User ID) — لتفعيل الأوامر الإدارية الحساسة
OWNER_ID=

# مستوى السجلات: trace | debug | info | warn | error
LOG_LEVEL=info

# مسار قاعدة البيانات (افتراضي bot/data/bot.sqlite)
DATABASE_PATH=./data/bot.sqlite

# مسار حفظ الجلسات الصوتية والـ clips
RECORDINGS_DIR=./data/recordings

# الحد الأقصى لمدة الـ rolling buffer بالدقائق (الافتراضي 30)
MAX_BUFFER_MINUTES=30

# جودة الفيديو النهائي: low | medium | high
RENDER_QUALITY=medium

# =============== Companion App (اختياري) ===============
# هذه القيم تخص bot/.env وليست companion/.env.
# إذا كان الـ companion على نفس الجهاز، المنفذ الافتراضي الذي يسمع عليه هو 8788.
COMPANION_WS_URL=
COMPANION_AUTH_TOKEN=

# توافق اختياري: لو نسخت قيم companion/.env هنا بالغلط، سيستنتج البوت
# COMPANION_WS_URL من BOT_WS_URL بإضافة 1 للمنفذ (8787 -> 8788)، ويستخدم BOT_AUTH_TOKEN.
BOT_WS_URL=
BOT_AUTH_TOKEN=
